# Copy this file to .env. Never commit real API keys.
APP_ENV=development
APP_NAME=Star Rail Agents
APP_VERSION=0.1.0
# 前端代理和 Nginx 当前按 /api/v1 配置；修改此项时必须同步修改前端代理。
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:8030"]

POSTGRES_DB=star_rail_agents
POSTGRES_USER=star_rail
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
FRONTEND_HOST_PORT=8030
# Docker Compose 会依据上面的账号重建容器内连接串；本行供宿主机/PyCharm 直接运行后端。
DATABASE_URL=postgresql+psycopg://star_rail:change-me@localhost:5432/star_rail_agents

# 以下地址供宿主机/PyCharm 使用；Docker Compose 会覆盖为容器内部服务名和端口。
MILVUS_HOST=localhost
MILVUS_PORT=19531
MILVUS_HOST_PORT=19531
MILVUS_COLLECTION=star_rail_knowledge_bge_m3_v2
RAG_TOP_K=5

BGE_SERVICE_HOST_PORT=8001
BGE_SERVICE_URL=http://localhost:8001
# 使用正斜杠填写 Windows 绝对路径，例如 D:/StarRailResources/models。
BGE_MODELS_PATH=./models
BGE_DEVICE=cuda
BGE_PRELOAD=true
BGE_EMBEDDING_BATCH_SIZE=8
BGE_RERANKER_BATCH_SIZE=4
BGE_RERANKER_MAX_LENGTH=512

# 游戏图片可以放在仓库外；目录下应包含 characters、lightcones、relics、items 等子目录。
GAME_ASSETS_PATH=./docs/data/assets
# Docker 挂载的本地知识根目录。默认沿用 docs，但完整知识文件不会进入 Git。
KNOWLEDGE_DATA_PATH=./docs
# PyCharm/宿主机直接启动后端时使用；通常与 KNOWLEDGE_DATA_PATH 指向同一目录。
DOCS_ROOT=./docs

# 离线演示默认不调用付费模型。启用 AI 时改为 zhipu、deepseek 或 qwen，
# 并只在本地 .env 填写对应密钥。
DEFAULT_LLM_PROVIDER=mock
LLM_TEMPERATURE=0.1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 智谱 GLM（OpenAI 兼容接口）；DEFAULT_LLM_PROVIDER=zhipu 时启用
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6
ZHIPU_FLASH_MODEL=glm-4-flash
ZHIPU_PRO_MODEL=glm-4.6
ZHIPU_INTENT_MODEL=glm-4.7

# 主 Agent：fc=现役原生 Function Calling 循环；react=兼容回退。
# FC 当前支持 zhipu/deepseek；mock 或 qwen 会安全回退到 ReactMainAgent。
MAIN_AGENT_IMPL=fc

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
# 仅填写注册用户名（不是邮箱），多个用户名用英文逗号分隔；留空表示没有管理员。
ADMIN_USERNAMES=
